<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration PUBLIC "-//APACHE//DTD LOG4J 1.2//EN" "log4j.dtd">
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

    <!-- Appenders -->
    <appender name="console" class="org.apache.log4j.ConsoleAppender">
        <param name="Target" value="System.out" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{HH:mm:ss.SSS} %-5p %c{2} - %m%n" />
        </layout>
    </appender>

    <!-- 우리 코드: 서비스 로그 + MyBatis 매퍼(namespace = com.finns.*.mapper)가 실행한 SQL과 파라미터 -->
    <logger name="com.finns">
        <level value="debug" />
    </logger>

    <!-- 로그가 매우 많은 라이브러리는 경고 이상만 -->
    <logger name="com.zaxxer.hikari">
        <level value="warn" />
    </logger>
    <logger name="org.mybatis.spring">
        <level value="warn" />
    </logger>

    <!-- 나머지(Spring 등)는 시작·오류 같은 중요한 로그만 -->
    <root>
        <priority value="info" />
        <appender-ref ref="console" />
    </root>

</log4j:configuration>
