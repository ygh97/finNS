# docker compose 가 읽는 운영 설정. .env 로 복사해 값을 채운다 (.env 는 저장소에 올리지 않음)

# 사이트 주소 - DuckDNS 서브도메인 등. Caddy가 이 주소로 HTTPS 인증서를 받는다
DOMAIN=finns.duckdns.org

# DB 비밀번호 - 아무 긴 문자열 (예: openssl rand -base64 24)
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# JWT 서명 키 - 32바이트 이상 (예: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME
